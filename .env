# ── Contoh environment variables — salin jadi .env lalu sesuaikan ──

# Database (SQLite lokal). Di Vercel boleh dikosongkan → fallback memori otomatis.
DATABASE_URL="file:./db/custom.db"

# Oracle AI (opsional). Tanpa ini, sandbox memakai SDK internal & Vercel memakai mode cadangan.
# Kompatibel semua penyedia OpenAI-compatible (Z.AI, OpenAI, dll).
AI_API_KEY=""
AI_BASE_URL="https://api.z.ai/api/paas/v4"
AI_MODEL="glm-4.6"

# Gerbang VVIP — Oracle AI hanya untuk Member VVIP.
# Halaman lounge: #/vvip · Dashboard member: #/member · Panel CEO: #/admin
# Kosongkan untuk memakai kode bawaan: GUNARA-VVIP-2026
VVIP_ACCESS_CODE="GUNARA-VVIP-2026"

# Panel CEO (/#/admin) — kata sandi akses dashboard admin.
# GANTI segera di production! Kosongkan = memakai bawaan: GUNARA-CEO-2026
ADMIN_PASSWORD="GUNARA-CEO-2026"

# ── SEO / Search Console ─────────────────────────────────────────────────────
# Domain produksi (dipakai canonical, sitemap, JSON-LD, og:image).
# Contoh: https://topkonsultan.web.id atau https://www.topkonsultan.web.id
NEXT_PUBLIC_SITE_URL="https://topkonsultan.web.id"

# Kode verifikasi mesin pencari (dari Search Console / Bing Webmaster / Yandex).
# Kosongkan bila belum mendaftar — meta verifikasi otomatis dilewati.
# Google Search Console → pilih metode "HTML tag" → salin isi content="…"
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
YANDEX_SITE_VERIFICATION=""

# Google Analytics 4 (opsional). Isi Measurement ID (format G-XXXXXXXXXX)
# dari analytics.google.com → situs otomatis memasang gtag. Kosong = tidak ada
# skrip analytics sama sekali (Lighthouse Best Practices tetap 100).
NEXT_PUBLIC_GA_ID=""

# IndexNow key (Bing/Yandex/Naver/Seznam/Yep). Default: gunara7f3a9c21b6d4e805
# File verifikasi public/<KEY>.txt sudah ada; jika mengubah key di sini,
# buat file public/<KEY>-baru.txt yang berisi persis nilai key-nya.
INDEXNOW_KEY="gunara7f3a9c21b6d4e805"

# ── Backup otomatis ──
# Jeda backup otomatis dalam jam (0 = matikan). Arsip .tar.gz di folder backups/.
BACKUP_INTERVAL_HOURS="24"
# Jumlah arsip yang dipertahankan (yang lama otomatis dihapus).
BACKUP_KEEP="10"
